# Copy to .env and fill in SMTP_PASS (Gmail "app password", 16 letters, spaces are ignored).
# Leave SMTP_PASS empty to run in DEV MODE: codes are printed in the server log instead of e-mailed.
SMTP_USER=okofficial.info@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=Rowan

